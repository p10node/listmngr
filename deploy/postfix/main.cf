# Front MTA for the Compose deployment (deploy/postfix/Dockerfile). Internet
# SMTP in for the list domains, LMTP to listmngr, relay out for listmngr.
# The entrypoint sets myhostname, mynetworks and relayhost from the
# environment. On a shared MTA copy only the relay/transport lines below and
# keep list domains out of mydestination and the virtual domain classes.
compatibility_level = 3.10
myhostname = lists.example.invalid
smtpd_banner = $myhostname ESMTP
inet_interfaces = all
inet_protocols = all
maillog_file = /dev/stdout

# No local delivery at all: every accepted recipient is a list address.
mydestination =
local_recipient_maps =
local_transport = error:5.1.1 local delivery is disabled
alias_maps =
alias_database =

# listmngr publishes immutable generations under /var/lib/listmngr/mta and
# switches `current`; the entrypoint reloads Postfix when it changes.
relay_domains = regexp:/var/lib/listmngr/mta/current/domains.regexp
relay_recipient_maps = regexp:/var/lib/listmngr/mta/current/recipients.regexp
transport_maps = regexp:/var/lib/listmngr/mta/current/transport.regexp
smtpd_reject_unlisted_recipient = yes
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = reject_non_fqdn_recipient, permit_mynetworks, reject_unauth_destination, reject_unlisted_recipient
smtpd_helo_required = yes
disable_vrfy_command = yes
# The regexp maps match the full VERP address (list-bounces+local=domain);
# never let Postfix strip an extension first.
recipient_delimiter =
# Matches mta.max_message_bytes; the LMTP listener enforces its own limit.
message_size_limit = 10485760

# Outbound: opportunistic TLS with the public roots; set relayhost through
# POSTFIX_RELAYHOST for a smart host, otherwise direct MX delivery.
smtp_tls_security_level = may
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
smtp_tls_loglevel = 1
