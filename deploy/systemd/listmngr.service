[Unit]
Description=listmngr mailing-list manager
Documentation=file:/usr/share/doc/listmngr/README.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=listmngr
Group=listmngr
EnvironmentFile=-/etc/listmngr/listmngr.env
ExecStart=/usr/bin/listmngr --config /etc/listmngr/listmngr.toml serve
Restart=on-failure
RestartSec=5s

StateDirectory=listmngr
StateDirectoryMode=0750
WorkingDirectory=/var/lib/listmngr
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
