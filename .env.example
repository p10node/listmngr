# Local-development values only. Copy to .env and replace the password.
# Docker Compose URL (the hostname `postgres` is only valid inside its network):
POSTGRES_PASSWORD=change-me-for-local-development
LISTMNGR_PORT=8000
RUST_LOG=info
# Public identity of the deployment: the web base URL and the mail hostname
# Postfix announces (also listmngr's Message-ID and authserv-id host).
LISTMNGR_BASE_URL=http://127.0.0.1:8000
LISTMNGR_MAIL_HOSTNAME=lists.example.invalid
# Where Postfix accepts internet mail for the list domains; 0.0.0.0:25 for a
# real deployment, a loopback port for local trials.
POSTFIX_SMTP_LISTEN=127.0.0.1:2525
# Optional outbound smart host for Postfix ("[host]:port"); empty = direct MX.
POSTFIX_RELAYHOST=

# Host-side Rust commands do not automatically load this file. Export this URL
# as LISTMNGR__DATABASE__URL after sourcing .env; localhost is intentional.
LISTMNGR_HOST_DATABASE_URL=postgres://listmngr:change-me-for-local-development@127.0.0.1:5432/listmngr
