target/
.DS_Store
.env
*.db
data/
playwright-report/
test-results/
__pycache__/
*.pyc

# Per-workstation Cargo limits (job count, incremental); CI must not inherit them.
.cargo/
# Local agent session logs; never part of the repository.
.hermes/

# Session handoff notes; docs/PLAN.md and docs/FEATURE_PARITY.md are the record.
docs/HANDOFF.md

# The real Mailman 3 and HyperKitty databases the importer is tested against.
!crates/import/tests/fixtures/mailman3/mailman.db
!crates/import/tests/fixtures/hyperkitty/hyperkitty.db

# `cargo cyclonedx` writes one SBOM per workspace member; the release job uploads crates/cli/listmngr.cdx.json.
*.cdx.json
